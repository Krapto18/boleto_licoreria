@page
@model Boleto.Web.Pages.IndexModel
<!DOCTYPE html>
<html lang="es-PE">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@Model.Catalogo.Config.Tienda · Abierto las 24 horas, todos los días</title>
<meta name="description" content="Licorería abierta 24 horas. Tienda y WhatsApp siempre atendiendo. Arma tu pedido y mándalo por WhatsApp. Coca Cola 1.5 L gratis con cualquier whisky o ron.">

<meta property="og:title" content="Boleto Licorería · Abierto las 24 horas">
<meta property="og:description" content="A la hora que sea. Tienda y WhatsApp abiertos 24/7.">
<meta property="og:type" content="website">
<meta property="og:image" content="~/assets/og.png">
<meta name="theme-color" content="#000725">

<link rel="icon" href="~/assets/favicon.svg" type="image/svg+xml" asp-append-version="true">
<link rel="manifest" href="~/manifest.webmanifest">
<link rel="apple-touch-icon" href="~/assets/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@@6..96,400;6..96,700&family=Jost:wght@@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
@if (Model.SchemaJson is not null)
{
    <script type="application/ld+json">@Html.Raw(Model.SchemaJson)</script>
}
</head>
<body>

<a href="#catalogo" class="skip">Ir al catálogo</a>

<div class="promobar"><div class="promobar__t" id="promobar"></div></div>

<!-- ══════════ NAV ══════════
     El buscador ocupa el lugar donde estaba el sello "Abierto ahora".
     El 24/7 no se pierde: lo siguen diciendo la franja roja de arriba y
     el hero con la hora del propio cliente.

     En móvil el menú se pliega en una hamburguesa. Es una decisión del
     cliente, no una recomendación: esconder la navegación cuesta clics
     (Nielsen #6, reconocer en vez de recordar). Lo que sí se cuida es
     que el que quede plegado funcione bien — foco, Escape, 44 px — y
     que el buscador del catálogo siga a la vista sin abrir nada. -->
<nav class="nav">
  <div class="nav__in">
    <a href="#" class="logo" aria-label="Boleto Licorería — inicio">
      <span class="logo__mark">B</span>
      <span class="logo__txt">Boleto<small>Licorería</small></span>
    </a>

    <button class="burger" id="burger" type="button"
            aria-expanded="false" aria-controls="navMenu" aria-label="Abrir menú">
      <span class="burger__caja" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <div class="nav__menu" id="navMenu">
      <div class="nav__links">
        <a href="#catalogo">Catálogo</a>
        @* Solo en escritorio: en móvil el cliente pidió únicamente
           el logo y el catálogo. La promoción sigue a un scroll y la
           franja roja la anuncia en todas las pantallas. *@
        <a href="#promo" class="nav__link--esc">Promoción</a>
      </div>
      <label class="search search--nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input type="search" id="qNav" placeholder="Buscar producto…"
               aria-label="Buscar producto en el catálogo" autocomplete="off">
      </label>
    </div>
  </div>
</nav>

<!-- ══════════ HERO ══════════ -->
<header class="hero">
  <div class="wrap">
    <div class="cartel">
      @* SLOT: logotipo sin el "24". Si el archivo no existe, cae al texto. *@
      <img src="~/assets/logotipo.svg" alt="@Model.Catalogo.Config.Tienda"
           class="cartel__logo" asp-append-version="true"
           onerror="this.replaceWith(Object.assign(document.createElement('p'),{className:'eyebrow',textContent:'@Model.Catalogo.Config.Tienda'}))">
      <h1 class="display">A la hora<br>que sea</h1>
      <svg class="flourish" viewBox="0 0 340 16" aria-hidden="true">
        <path d="M14 8h140" stroke="currentColor" stroke-width="1.6"/>
        <path d="M186 8h140" stroke="currentColor" stroke-width="1.6"/>
        <path d="M170 1.5l6.5 6.5-6.5 6.5-6.5-6.5z" fill="currentColor"/>
        <circle cx="8" cy="8" r="4" fill="currentColor"/><circle cx="332" cy="8" r="4" fill="currentColor"/>
      </svg>
      <p class="cartel__p">
        Tienda y WhatsApp abiertos <b>las 24 horas, todos los días</b>.
        Son las <b id="relojHero">—</b> y estamos atendiendo.
      </p>
      <a class="btn btn--wa btn--xl" id="heroWa" href="#" target="_blank" rel="noopener">
        <svg class="i-wa" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z"/></svg>
        Escribir por WhatsApp
      </a>
      <p class="cartel__sub"><a href="#catalogo">o mira el catálogo y arma tu pedido</a></p>
    </div>
  </div>
</header>

<!-- ══════════ BANNERS · CARRUSEL 1 ══════════
     Cada carrusel se rinde solo si tiene banners cargados. Sin
     imágenes, no aparece ninguno de los dos.

     Los dos no van juntos a propósito: diez banners de 1200×500 uno
     debajo del otro empujan el catálogo fuera de la primera pantalla,
     que es lo que el cliente vino a ver. El primero va antes del
     catálogo y el segundo después, así la segunda tanda aparece cuando
     ya terminó de mirar productos. -->
<section class="banners" id="bannersSec1" hidden>
  <div class="wrap">
    <div class="carrusel" id="carrusel1" role="region" aria-roledescription="carrusel" aria-label="Promociones">
      <div class="carrusel__pista" id="pista1"></div>
    </div>
    <div class="carrusel__puntos" id="puntos1" role="tablist" aria-label="Ir a promoción"></div>
  </div>
</section>

<!-- ══════════ PROMO ══════════ -->
<section class="sec" id="promo">
  <div class="wrap">
    <div class="promo">
      <div>
        <p class="eyebrow eyebrow--red">Hasta agotar stock</p>
        <h2 class="display promo__h">Coca&nbsp;Cola 1.5&nbsp;L<br><em>gratis</em></h2>
        <svg class="flourish flourish--sm" viewBox="0 0 340 16" aria-hidden="true">
          <path d="M14 8h140" stroke="currentColor" stroke-width="1.6"/>
          <path d="M186 8h140" stroke="currentColor" stroke-width="1.6"/>
          <path d="M170 1.5l6.5 6.5-6.5 6.5-6.5-6.5z" fill="currentColor"/>
          <circle cx="8" cy="8" r="4" fill="currentColor"/><circle cx="332" cy="8" r="4" fill="currentColor"/>
        </svg>
        <p class="promo__p">Por la compra de cualquier <b>whisky</b> o <b>ron</b>.</p>
        <button class="btn btn--line btn--dark" id="promoBtn">Ver los que aplican</button>
      </div>
      <div aria-hidden="true"><span class="seal"><em>Gratis</em><b>1.5 L</b></span></div>
    </div>
  </div>
</section>

<!-- ══════════ CATÁLOGO ══════════ -->
<section class="sec" id="catalogo">
  <div class="wrap">
    <div class="sec__head">
      <p class="eyebrow">Precios de hoy</p>
      <h2 class="display sec__h">Arma tu pedido</h2>
      <svg class="flourish flourish--c" viewBox="0 0 340 16" aria-hidden="true">
        <path d="M14 8h140" stroke="currentColor" stroke-width="1.6"/>
        <path d="M186 8h140" stroke="currentColor" stroke-width="1.6"/>
        <path d="M170 1.5l6.5 6.5-6.5 6.5-6.5-6.5z" fill="currentColor"/>
        <circle cx="8" cy="8" r="4" fill="currentColor"/><circle cx="332" cy="8" r="4" fill="currentColor"/>
      </svg>
      <p class="sec__p">Marca lo que quieres. Abajo se arma el mensaje y lo mandas con un toque.</p>
    </div>

    <label class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" id="q" placeholder="Buscar: chivas, pilsen, hielo…" aria-label="Buscar producto">
    </label>

    <div class="chips" id="chips" role="group" aria-label="Filtrar por tipo"></div>
    <p class="count" id="count" role="status"></p>
    <div class="grid" id="grid"></div>
    <p class="empty" id="empty" hidden>No encontramos eso. Escríbenos y lo conseguimos.</p>
  </div>
</section>

<!-- ══════════ BANNERS · CARRUSEL 2 ══════════ -->
<section class="banners banners--abajo" id="bannersSec2" hidden>
  <div class="wrap">
    <div class="carrusel" id="carrusel2" role="region" aria-roledescription="carrusel" aria-label="Más promociones">
      <div class="carrusel__pista" id="pista2"></div>
    </div>
    <div class="carrusel__puntos" id="puntos2" role="tablist" aria-label="Ir a promoción"></div>
  </div>
</section>

<!-- ══════════ DELIVERY ══════════
     Se rinde solo si hay zonas confirmadas. Sin datos, no aparece. -->
@if (Model.Catalogo.Config.Zonas.Length > 0)
{
<section class="sec sec--alt" id="delivery">
  <div class="wrap">
    <div class="sec__head">
      <p class="eyebrow">Dónde llegamos</p>
      <h2 class="display sec__h">Zonas de reparto</h2>
      @if (!string.IsNullOrWhiteSpace(Model.Catalogo.Config.TiempoEntrega))
      {
        <p class="sec__p">@Model.Catalogo.Config.TiempoEntrega</p>
      }
    </div>
    <ul class="zonas" id="zonas"></ul>
    <p class="zonas__nota">¿Estás fuera de estas zonas? Escríbenos y coordinamos.</p>
  </div>
</section>
}

<!-- ══════════ PAGOS ══════════ -->
@if (Model.Catalogo.Config.Pagos.Length > 0)
{
<section class="sec sec--pagos">
  <div class="wrap">
    <p class="eyebrow eyebrow--c">Formas de pago</p>
    <ul class="pagos" id="pagos"></ul>
  </div>
</section>
}

<!-- ══════════ CIERRE ══════════ -->
<section class="close">
  <div class="wrap">
    <h2 class="display close__h">¿Se acabó el hielo<br>a las 3 de la mañana?</h2>
    <p class="close__p">Escríbenos igual. No cerramos nunca.</p>
    <a class="btn btn--wa btn--xl" id="closeWa" href="#" target="_blank" rel="noopener">
      <svg class="i-wa" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z"/></svg>
      Escribir por WhatsApp
    </a>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <div class="foot__in">
      <div class="logo">
        <span class="logo__mark">B</span>
        <span class="logo__txt">Boleto<small>Licorería</small></span>
      </div>
      <div class="foot__soc">
        <a href="https://instagram.com/@Model.Catalogo.Config.Instagram" target="_blank" rel="noopener">
          <svg class="i-soc" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.39C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.39 2.12.66.67 1.33 1.09 2.12 1.39.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.12-1.39.67-.66 1.09-1.33 1.39-2.12.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.72-1.46-1.39-2.12C21.32 1.35 20.65.93 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zM12 16a4 4 0 114-4 4 4 0 01-4 4zm7.85-10.4a1.44 1.44 0 11-1.44-1.44 1.44 1.44 0 011.44 1.44z"/></svg>
          <span>Instagram</span></a>
        <a href="https://tiktok.com/@@@Model.Catalogo.Config.TikTok" target="_blank" rel="noopener">
          <svg class="i-soc" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82a4.28 4.28 0 01-1.03-2.82h-3.2v12.9a2.59 2.59 0 01-2.59 2.5 2.6 2.6 0 01-2.6-2.6 2.6 2.6 0 013.2-2.53V9.99a5.83 5.83 0 00-.6-.04A5.83 5.83 0 003.95 15.8a5.83 5.83 0 0011.66 0V9.01a7.5 7.5 0 004.39 1.4V7.22a4.29 4.29 0 01-3.4-1.4z"/></svg>
          <span>TikTok</span></a>
        <a href="#" id="footWa" target="_blank" rel="noopener">
          <img src="~/assets/whatsapp.svg" alt="" class="i-soc" aria-hidden="true">
          <span>@Model.Catalogo.Config.Telefono</span></a>
      </div>
    </div>
    <p class="legal">
      Tomar bebidas alcohólicas en exceso es dañino. Prohibida la venta de bebidas alcohólicas a menores de 18 años
      (Ley N° 28681). Se solicitará DNI al momento de la entrega. Precios sujetos a cambio y stock disponible.
    </p>
    <p class="legal legal--c">© <span id="year"></span> Boleto Licorería</p>
  </div>
</footer>

<!-- ══════════ BARRA DE PEDIDO ══════════ -->
<div class="orderbar" id="bar" data-on="false" data-peek="false">
  <div class="preview">
    <div class="preview__in">
      <p class="preview__lbl">Esto es lo que se va a enviar</p>
      <div class="bubble" id="bubble"></div>
    </div>
  </div>
  @* El distrito va FUERA de la vista previa, que está colapsada por
     defecto y solo se abre sola una vez. Adentro, el cliente podía
     mandar el pedido sin elegirlo y enterarse del delivery cuando la
     tienda le respondía. Acá se ve siempre que hay algo en el pedido. *@
  @if (Model.Catalogo.Config.Zonas.Length > 0)
  {
    <label class="distrito" id="distritoCaja" data-pendiente="true">
      <span class="distrito__lbl" id="distritoLbl">Tu distrito</span>
      <select id="distritoSel" aria-label="Elige tu distrito para calcular el delivery"></select>
    </label>
  }
  <div class="orderbar__in">
    <button class="peek" id="peek" aria-expanded="false" aria-controls="bubble">
      <span class="peek__sum"><b id="barTotal">S/ 0.00</b><span id="barCount">0 productos</span></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
    </button>
    <a class="btn btn--wa btn--xl" id="barWa" href="#" target="_blank" rel="noopener">
      <svg class="i-wa" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z"/></svg>
      <span>Enviar pedido</span>
    </a>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite" data-on="false">
  <span id="toastTxt"></span>
  <button id="undo">Deshacer</button>
</div>

<!-- Instalar en el celular: para una tienda 24/7, un ícono en la
     pantalla de inicio es el atajo de las 3 a.m. -->
<div class="install" id="install" data-on="false">
  <span>Guarda la licorería en tu pantalla de inicio</span>
  <button id="installBtn">Instalar</button>
  <button id="installNo" aria-label="Cerrar">✕</button>
</div>

<a class="float" id="float" href="#" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z"/></svg>
</a>

@* El catálogo sale de la base de datos, no de un archivo estático.
   Se declaran las mismas globales que tenía data.js: app.js no cambia. *@
@* Verificación regulatoria (Ley N° 28681). El contenido se rinde igual
   en el HTML: Google lo indexa completo. La pantalla se superpone por
   JavaScript, que los rastreadores no ejecutan. *@
@if (Model.Catalogo.Config.Verificar18)
{
<div class="edad" id="edad" data-on="false" role="dialog" aria-modal="true" aria-labelledby="edadT">
  <div class="edad__box" id="edadAsk">
    <img src="~/assets/logo.svg" alt="@Model.Catalogo.Config.Tienda" class="edad__logo" asp-append-version="true">
    <h2 class="display" id="edadT">¿Eres mayor de 18 años?</h2>
    <p>La venta de bebidas alcohólicas a menores de edad está prohibida en el Perú (Ley N° 28681).</p>
    <div class="edad__btns">
      <button class="btn btn--marino" id="edadSi">Sí, soy mayor de 18</button>
      <button class="btn btn--line btn--dark" id="edadNo">No</button>
    </div>
    <p class="edad__legal">Se solicitará DNI al momento de la entrega.</p>
  </div>
  <div class="edad__box edad__box--no" id="edadStop" hidden>
    <h2 class="display">Vuelve cuando cumplas 18</h2>
    <p>Gracias por tu honestidad. No podemos venderte bebidas alcohólicas.</p>
  </div>
</div>
}

<script>@Html.Raw(Model.CatalogoJs)</script>
<script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
